# ============================================================
# VERSIN · Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o repositório!
# ============================================================

# --- Banco de Dados ---
MYSQL_ROOT_PASSWORD=root_senha_forte
MYSQL_DATABASE=versin
MYSQL_USER=versin_user
MYSQL_PASSWORD=versin_senha_forte

# --- Backend (FastAPI) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=versin
DB_USER=versin_user
DB_PASSWORD=versin_senha_forte
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
